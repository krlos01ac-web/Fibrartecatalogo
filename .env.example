# ==============================================================
# Fibrarte - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env ou .env.local e preencha os valores
# NUNCA commite arquivos .env ou .env.local no repositório Git!
# ==============================================================

# Credenciais do Firebase Firestore (Web SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Senha de Acesso à Gestão / Painel das Artesãs
VITE_ADMIN_PASSWORD=
